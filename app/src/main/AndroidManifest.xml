<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 批v160 W8: "agent needs you" alerts + the optional keep-alive service.
      FOREGROUND_SERVICE_DATA_SYNC is the API-34 typed-foreground requirement;
      on <33 the base FOREGROUND_SERVICE covers it. POST_NOTIFICATIONS is a
      runtime request on 33+ (Settings toggle); below 33 grants implicitly. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 系统级通知体系: the P0 alert vibrates and may promote to a full-screen
      intent while the screen is locked (interactive_requests channel). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- feat/tv M1: single-APK TV support. Both non-required so phones (and TV
      boxes without leanback) keep installing the exact same build; the TV
      launcher picks the activity up via the LEANBACK_LAUNCHER category below. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".CodegApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Codeg"
        android:usesCleartextTraffic="true">
        <!--
          usesCleartextTraffic: codeg servers commonly run on a plain-HTTP LAN
          address (e.g. http://192.168.x.x:3080). Mirrors the iOS app's
          NSAllowsArbitraryLoads.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Codeg"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- codeg:// deep links (tab / conversation / project / settings). -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="codeg" />
            </intent-filter>
        </activity>

        <!-- Share-out for document previews (batch v123). The authority is
          `${applicationId}.fileprovider` — the fork's per-variant applicationId
          suffixes (fengx / .legacy) make a literal authority collide when both
          flavors are installed on one device. -->
        <!-- 批v160 W8: optional keep-alive (后台保持监听) foreground service. -->
        <service
            android:name=".core.notify.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
