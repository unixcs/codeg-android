<?xml version="1.0" encoding="utf-8"?>
<!-- feat/tv M1 slice 1: TV launcher banner PLACEHOLDER (nominal 320x180dp).
     Lint MissingTvBanner fails the build once the manifest carries a
     LEANBACK_LAUNCHER intent filter; this keeps slice 1 compile-green until
     the designed banner ships with the TV shell slice. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#122E33" />
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="rectangle">
            <size android:width="160dp" android:height="10dp" />
            <solid android:color="#2DD3C0" />
        </shape>
    </item>
</layer-list>
